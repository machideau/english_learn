# --- OpenRouter ---
# Obtenez votre clé sur https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Modèles IA ---
# Modèle de conversation et de correction (LLM)
# Exemples : openai/gpt-4o-mini, openai/gpt-4o, anthropic/claude-3-haiku
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# Modèle de transcription audio -> texte
# Exemples : openai/whisper-large-v3, openai/whisper-1
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3

# Modèle de synthèse vocale (TTS)
# Exemples : openai/tts-1, openai/tts-1-hd
OPENROUTER_TTS_MODEL=openai/tts-1

# Voix du personnage avatar
# Options : alloy, echo, fable, onyx, nova, shimmer
OPENROUTER_TTS_VOICE=nova

# --- Scoring de prononciation ---
# "llm" = analyse via LLM (fiabilité limitée, aucune config requise)
# "azure" = Azure Speech SDK (fiabilité élevée, nécessite un abonnement Azure)
PRONUNCIATION_SCORER=llm

# --- Azure Speech Service (optionnel) ---
# Requis uniquement si PRONUNCIATION_SCORER=azure
# Documentation : https://docs.microsoft.com/azure/cognitive-services/speech-service/
# AZURE_SPEECH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_SPEECH_REGION=westeurope

# --- Rate limiting des routes API ---
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
